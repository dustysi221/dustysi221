# Copy this file to .env and fill in your key:  copy .env.example .env
# Get a key at https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=your-key-here

# --- Server -------------------------------------------------------------
# 127.0.0.1 = this PC only. Use 0.0.0.0 to open the dashboard from a tablet/phone on your LAN.
HOST=127.0.0.1
PORT=3000

# --- Telemetry ------------------------------------------------------------
# auto = LMU shared memory on Windows, simulator elsewhere | rf2 | mock
TELEMETRY_SOURCE=auto
# Simulator time multiplier (e.g. 10 = laps go by 10x faster)
MOCK_SPEED=1
# Simulator session to start in: practice, qualifying or race (switch any time in the Control Panel)
MOCK_SESSION=race
BROADCAST_HZ=10
TIRE_SAMPLE_MS=1000

# --- Claude analysis ------------------------------------------------------
# Every call costs money: at 5 s with claude-opus-5 expect roughly $20-25 per hour of driving,
# with claude-sonnet-5 about $9. See "API cost" in README.md.
# Analysis only runs while a dashboard is connected and the car is live.
ANALYSIS_INTERVAL_MS=5000
ANALYSIS_MODEL=claude-opus-5
# low | medium | high | xhigh | max  (higher = slower, deeper, pricier)
ANALYSIS_EFFORT=low
# Retry declined requests on Anthropic's recommended fallback model
ANALYSIS_FALLBACKS=true

# --- Tire analysis --------------------------------------------------------
# Reference operating window sent to Claude and used as the dashboard default.
# Generic default; set it to your car/compound's window if you know it.
TIRE_OPTIMAL_MIN_C=75
TIRE_OPTIMAL_MAX_C=100
# Wear % at which a tire counts as done; drives the pit-window projection
TIRE_WEAR_LIMIT_PERCENT=75

# --- Strategy -------------------------------------------------------------
# Strategy calls run after every completed lap and pit stop (about one call per lap).
# Time lost for a pit stop incl. pit lane, in seconds. Estimate for your track.
PIT_LOSS_SEC=35
# Extra fuel to carry to the flag, in laps
FUEL_RESERVE_LAPS=1
# Refresh the strategy at least this often during very long laps
STRATEGY_MAX_INTERVAL_MS=180000

# --- Voice engineer -------------------------------------------------------
# Claude effort for push-to-talk answers (low = fastest reply)
VOICE_EFFORT=low
